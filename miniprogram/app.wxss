page { background: #f7f8f2; color: #1e3028; font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", sans-serif; font-size: 28rpx; }
view, text, input, button { box-sizing: border-box; }
button { margin: 0; padding: 0 28rpx; font-size: 28rpx; font-weight: 600; border-radius: 20rpx; line-height: 88rpx; }
button::after { border: none; }
button[disabled] { opacity: .48; }
.page { padding: 36rpx 32rpx 64rpx; }
.eyebrow { color: #738170; font-size: 22rpx; letter-spacing: 4rpx; margin-bottom: 18rpx; }
.title { font-size: 48rpx; font-weight: 700; line-height: 1.3; letter-spacing: -1rpx; }
.subtitle { color: #748074; font-size: 26rpx; line-height: 1.7; margin-top: 16rpx; }
.card { background: #fff; border: 1rpx solid #e8ede3; border-radius: 28rpx; padding: 32rpx; margin-top: 24rpx; }
.card-title { font-weight: 650; font-size: 32rpx; }
.row { display: flex; align-items: center; justify-content: space-between; }
.row-start { display: flex; align-items: center; }
.row-start > view + view, .row-start > text + text { margin-left: 14rpx; }
.section-title { font-size: 32rpx; font-weight: 650; margin: 40rpx 0 12rpx; }
.primary { background: #235d46; color: #fff; }
.secondary { background: #eaf0e5; color: #235d46; }
.quiet { background: #f2f4ef; color: #687466; }
.danger { background: #faeee8; color: #a05a3d; }
.small { font-size: 24rpx; line-height: 64rpx; padding: 0 22rpx; border-radius: 14rpx; }
.link { background: transparent; color: #235d46; font-size: 24rpx; line-height: 60rpx; padding: 0 12rpx; }
.field { width: 100%; background: #f6f8f3; padding: 0 24rpx; height: 92rpx; border: 1rpx solid #e5ebdf; border-radius: 16rpx; color: #1e3028; font-size: 30rpx; margin: 24rpx 0; }
.label { font-size: 24rpx; color: #7c8779; }
.muted { color: #7c8779; font-size: 24rpx; line-height: 1.6; }
.tag { background: #eaf2e8; color: #235d46; font-size: 21rpx; line-height: 42rpx; padding: 0 16rpx; border-radius: 24rpx; white-space: nowrap; }
.tag.closed, .tag.rejected, .tag.revoked { background: #f0f1ed; color: #7c8477; }
.tag.pending { background: #fff3d9; color: #99732a; }
.divider { height: 1rpx; background: #edf0e8; margin: 26rpx 0; }
.metric { font-size: 40rpx; font-weight: 700; font-variant-numeric: tabular-nums; line-height: 1.5; word-break: break-all; }
.metrics { display: flex; margin-top: 24rpx; }
.metrics > view { flex: 1; min-width: 0; padding-right: 12rpx; }
.positive { color: #235d46; }
.empty { padding: 70rpx 30rpx; text-align: center; }
.empty-symbol { font-size: 64rpx; color: #a1b29a; margin-bottom: 20rpx; }
.spaced { margin-top: 24rpx; }
.actions { display: flex; margin-top: 24rpx; }
.actions > button { flex: 1; }
.actions > button + button { margin-left: 16rpx; }
.notice { padding: 22rpx 26rpx; border-radius: 18rpx; background: #fff3d9; color: #886b2d; font-size: 24rpx; line-height: 1.6; margin-top: 24rpx; }
.name { font-size: 28rpx; font-weight: 600; word-break: break-all; }
.avatar { width: 68rpx; height: 68rpx; flex-shrink: 0; border-radius: 22rpx; background: #eaf0e5; color: #235d46; display: flex; align-items: center; justify-content: center; font-weight: 650; }
.list-row { padding: 24rpx 0; border-bottom: 1rpx solid #edf0e8; }
.list-row:last-child { border-bottom: none; }
